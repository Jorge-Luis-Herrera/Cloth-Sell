# Copia este archivo a .env y rellena los valores.
# Genera ambos secretos con ./generate-secrets.sh

ADMIN_PASSWORD_HASH=pbkdf2$600000$BASE64_SALT$BASE64_HASH
AUTH_SIGNING_KEY=cambia-esta-clave-por-una-de-al-menos-32-caracteres

# Dominio apuntando a la IP publica de la VM (A record).
# Dejalo vacio para publicar solo por HTTP en la IP.
DOMAIN=

# Se calcula solo: https si hay DOMAIN, http si no.
PUBLIC_SCHEME=http

# Opcional. Si el frontend esta en otro dominio, ponlo aqui (separado por comas).
ALLOWED_ORIGINS=
